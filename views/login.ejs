        let currentLang = 'en';

        function saveLang(lang) {
            try { localStorage.setItem('lang', lang); } catch (e) {}
        }

        function loadLang() {
            try { return localStorage.getItem('lang'); } catch (e) { return null; }
        }

        function applyLanguage(lang) {
            if (!translations[lang]) lang = 'en';
            currentLang = lang;
            const t = translations[lang];
            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (t[key] !== undefined) el.textContent = t[key];
            });
            if (stepPassword.classList.contains('active')) {
                heading.textContent = t.welcome;
            }
            saveLang(lang);
        }

        function initLanguage() {
            const langSelect = document.getElementById('language-select');
            if (!langSelect) return; // footer not parsed yet
            langSelect.addEventListener('change', (e) => applyLanguage(e.target.value));                // Default to English; only override with the user's saved choice
                const savedLang = loadLang();
                if (savedLang && translations[savedLang]) {
                    currentLang = savedLang;
                }
            langSelect.value = currentLang;
            applyLanguage(currentLang);
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initLanguage);
        } else {
            initLanguage();
        }
    </script>
</body>
</html>
