<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Connecting…</title>
    <style>
        :root {
            --ok: #2ecc71;
            --dim: #6e6e73;
            --accent: #8ab4f8;
            --warn: #f5c26b;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: #111111;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Arial, sans-serif;
            color: #e8e8ed;
            padding: 24px;
        }

        .card {
            width: 100%;
            max-width: 420px;
            text-align: center;
        }

        h1 {
            font-size: 20px;
            font-weight: 600;
            letter-spacing: 0.3px;
            margin-bottom: 30px;
            color: #ffffff;
        }

        .steps {
            display: flex;
            flex-direction: column;
            gap: 16px;
            text-align: left;
        }

        .step {
            display: flex;
            align-items: center;
            gap: 14px;
            font-size: 15px;
            color: var(--dim);
            transition: color 0.2s ease;
        }

        .step .dot {
            width: 24px;
            height: 24px;
            flex: 0 0 24px;
            border-radius: 50%;
            border: 2px solid #2c2c2e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            font-weight: 700;
            transition: border-color 0.2s ease, background 0.2s ease;
        }

        .step.active {
            color: #e8e8ed;
        }

        .step.active .dot {
            border-color: var(--accent);
        }

        .step.done {
            color: #e8e8ed;
        }

        .step.done .dot {
            border-color: var(--ok);
            background: var(--ok);
            color: #0b0b0b;
        }

        .spin {
            width: 11px;
            height: 11px;
            border-radius: 50%;
            border: 2px solid rgba(138, 180, 248, 0.3);
            border-top-color: var(--accent);
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .hint {
            margin-top: 30px;
            font-size: 13px;
            line-height: 1.55;
            color: var(--dim);
        }

        .hint .warn {
            color: var(--warn);
        }

        .hint a {
            color: var(--accent);
        }
    </style>
</head>
<body>
    <div class="card">
        <h1 id="title">Connecting…</h1>

        <div class="steps">
            <div class="step" id="s1">
                <span class="dot">1</span>
                <span>Connected to <b><%= ssid %></b></span>
            </div>
            <div class="step" id="s2">
                <span class="dot"><span class="spin"></span></span>
                <span>Checking your access…</span>
            </div>
            <div class="step" id="s3">
                <span class="dot">3</span>
                <span>Connected to <b><%= upstream %></b></span>
            </div>
        </div>

        <p class="hint" id="hint">Please keep this window open.</p>
    </div>

    <script>
        var SSID = <%- JSON.stringify(ssid) %>;
        var UPSTREAM = <%- JSON.stringify(upstream) %>;

        var started = Date.now();
        var finished = false;

        function setStep(id, state) {
            document.getElementById(id).className = 'step' + (state ? ' ' + state : '');
        }

        function setDot(id, content) {
            document.querySelector('#' + id + ' .dot').innerHTML = content;
        }

        function finish(ok, data) {
            if (finished) return;
            finished = true;

            setStep('s1', 'done');
            setDot('s1', '&#10003;');

            if (!ok) {
                setStep('s2', '');
                setDot('s2', '2');
                document.getElementById('title').textContent = 'Almost there';
                document.getElementById('hint').innerHTML =
                    '<span class="warn">We could not confirm your access.</span> ' +
                    'Reconnect to <b>' + SSID + '</b> and sign in again.';
                return;
            }

            setStep('s2', 'done');
            setDot('s2', '&#10003;');
            setStep('s3', 'done');
            setDot('s3', '&#10003;');
            document.getElementById('title').textContent = 'You are online';

            if (data && data.uplinkOnline === false) {
                document.getElementById('hint').innerHTML =
                    'You are signed in, but the internet through <b>' + UPSTREAM +
                    '</b> is not available yet. Please ask the staff.';
            } else {
                document.getElementById('hint').textContent = 'Done. You can close this window.';
            }

            // Best effort: only script-opened windows may really close.
            try { window.close(); } catch (e) { /* ignore */ }
        }

        async function poll() {
            try {
                var res = await fetch('/grant-status', { cache: 'no-store' });
                var data = await res.json();
                if (data && data.granted) {
                    finish(true, data);
                    return;
                }
            } catch (e) { /* network hiccup: just retry */ }

            if (Date.now() - started > 25000) {
                finish(false, null);
                return;
            }
            setTimeout(poll, 1200);
        }

        setStep('s1', 'done');
        setDot('s1', '&#10003;');
        setStep('s2', 'active');
        poll();
    </script>
</body>
</html>
