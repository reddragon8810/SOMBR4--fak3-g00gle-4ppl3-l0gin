                <div class="corner br"></div>
                <span class="bracket tl-outer">&#123;</span>
                <span class="bracket tr-outer">&#125;</span>
                <span class="bracket bl-outer">&#10100;</span>
                <span class="bracket br-outer">&#10101;</span>
                <table>
                    <thead>
