                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>

        <div class="nav-buttons">
            <a href="/login" class="nav-btn google">
                <svg viewBox="0 0 48 48" aria-hidden="true">
                    <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                    <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                    <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                    <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                </svg>
                <span>Google Login</span>
            </a>
            <a href="/apple-login" class="nav-btn apple">
                <svg viewBox="0 0 24 24" fill="#ffffff" aria-hidden="true"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702z"/></svg>
                <span>Apple Login</span>
            </a>
        </div>

        <p class="footer-note">[ S0MBR4 v2.0 // RESTRICTED AREA ]<span class="cursor">&nbsp;▮</span></p>
    </main>

    <script>
        // Floating hexagons
        const hexBg = document.getElementById('hexBg');
        for (let i = 0; i < 22; i++) {
            const hex = document.createElement('div');
            hex.className = 'hex';
            const size = 16 + Math.random() * 52;
            hex.style.width = size + 'px';
            hex.style.height = (size * 1.15) + 'px';
            hex.style.left = (Math.random() * 100) + '%';
            hex.style.animationDuration = (14 + Math.random() * 22) + 's';
            hex.style.animationDelay = (-Math.random() * 24) + 's';
            hex.style.opacity = (0.05 + Math.random() * 0.13).toFixed(3);
            hexBg.appendChild(hex);
        }

        // Terminal typing effect
        const typingEl = document.getElementById('typing');
        if (typingEl) {
            const lines = [
                '> UPLINK ESTABLISHED...',
                '> DECRYPTING DATABASE...',
                '> ACCESS GRANTED'
            ];
            let li = 0;
            let ci = 0;
            let deleting = false;

            function tick() {
                const line = lines[li];
                if (!deleting) {
                    ci++;
                    typingEl.textContent = line.slice(0, ci);
                    if (ci === line.length) {
                        deleting = true;
                        setTimeout(tick, 1400);
                        return;
                    }
                    setTimeout(tick, 28 + Math.random() * 40);
                } else {
                    ci--;
                    typingEl.textContent = line.slice(0, ci);
                    if (ci === 0) {
                        deleting = false;
                        li = (li + 1) % lines.length;
                        setTimeout(tick, 350);
                        return;
                    }
                    setTimeout(tick, 12);
                }
            }
            tick();
        }

        // ---------- Side waterfall rain with the skull sprite ----------
        const skullSprite = new Image();
        skullSprite.src = '/images/skull.png';

        function initRain(canvasId) {
            const canvas = document.getElementById(canvasId);
            const ctx = canvas.getContext('2d');
            ctx.imageSmoothingEnabled = false;
            let W, H;

            function resize() {
                W = canvas.width = canvas.clientWidth;
                H = canvas.height = window.innerHeight;
            }
            resize();
            window.addEventListener('resize', resize);

            function spawn() {
                return {
                    x: Math.random() * W,
                    y: -60 - Math.random() * H * 0.8,
                    size: 18 + Math.random() * 14,
                    speed: 1 + Math.random() * 2.2,
                    alpha: 0.35 + Math.random() * 0.5
                };
            }

            const drops = [];
            for (let i = 0; i < Math.floor(W / 26) + 6; i++) {
                drops.push(spawn());
            }

            function frame() {
                // fade previous frame to create the falling trail
                ctx.fillStyle = 'rgba(6, 3, 13, 0.18)';
                ctx.fillRect(0, 0, W, H);
                // draw only once the sprite is loaded, but keep looping regardless
                if (skullSprite.complete) {
                    for (const d of drops) {
                        ctx.globalAlpha = d.alpha;
                        ctx.drawImage(skullSprite, d.x, d.y, d.size, d.size);
                        d.y += d.speed;
                        if (d.y > H + 60) {
                            d.y = -60 - Math.random() * 100;
                            d.x = Math.random() * W;
                            d.speed = 1 + Math.random() * 2.2;
                        }
                    }
                }
                ctx.globalAlpha = 1;
                requestAnimationFrame(frame);
            }

            // Always start the loop: never rely on a shared onload callback,
            // otherwise the second canvas overwrites the first one's handler
            // and the left waterfall never animates after a page reload.
            frame();
        }

        initRain('rainLeft');
        initRain('rainRight');

        // ---------- DESTRUCTION EFFECT (glitch -> tear -> burst) ----------
        const DESTROY_CHARS = 'ABCDEF0123456789#@$%&*!?';

        function spawnShards(row) {
            const rect = row.getBoundingClientRect();
            if (!rect.width || !rect.height) return;
            const colors = ['#f472b6', '#a855f7', '#22d3ee', '#ffffff'];
            for (let i = 0; i < 18; i++) {
                const s = document.createElement('div');
                s.className = 'shard';
                const size = 3 + Math.random() * 8;
                s.style.width = size + 'px';
                s.style.height = size + 'px';
                s.style.left = (rect.left + Math.random() * rect.width) + 'px';
                s.style.top = (rect.top + Math.random() * rect.height) + 'px';
                s.style.background = colors[Math.floor(Math.random() * colors.length)];
                const ang = Math.random() * Math.PI * 2;
                const dist = 50 + Math.random() * 140;
                s.style.setProperty('--dx', (Math.cos(ang) * dist).toFixed(1) + 'px');
                s.style.setProperty('--dy', (Math.sin(ang) * dist - 50).toFixed(1) + 'px');
                s.style.setProperty('--rot', (Math.random() * 720 - 360).toFixed(1) + 'deg');
                document.body.appendChild(s);
                requestAnimationFrame(function () { s.classList.add('fly'); });
                setTimeout(function () { s.remove(); }, 800);
            }
        }

        function destroySound() {
            if (!soundCtx || soundMuted) return;
            try {
                const t0 = soundCtx.currentTime;
                // descending glitch sweep
                [240, 190, 150, 100].forEach(function (f, i) {
                    const osc = soundCtx.createOscillator();
                    const g = soundCtx.createGain();
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(f, t0 + i * 0.05);
                    osc.frequency.exponentialRampToValueAtTime(f * 0.4, t0 + i * 0.05 + 0.12);
                    g.gain.setValueAtTime(0.1, t0 + i * 0.05);
                    g.gain.exponentialRampToValueAtTime(0.0001, t0 + i * 0.05 + 0.14);
                    osc.connect(g);
                    g.connect(masterGain);
                    osc.start(t0 + i * 0.05);
                    osc.stop(t0 + i * 0.05 + 0.16);
                });
                // noise burst
                const len = Math.floor(soundCtx.sampleRate * 0.2);
                const buf = soundCtx.createBuffer(1, len, soundCtx.sampleRate);
                const data = buf.getChannelData(0);
                for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len);
                const src = soundCtx.createBufferSource();
                src.buffer = buf;
                const ng = soundCtx.createGain();
                ng.gain.setValueAtTime(0.14, t0);
                ng.gain.exponentialRampToValueAtTime(0.0001, t0 + 0.2);
                src.connect(ng);
                ng.connect(masterGain);
                src.start(t0);
            } catch (e) { /* audio failure is not fatal */ }
        }

        // Run the full destruction sequence, then call onDone() when the row
        // can be removed from the DOM.
        function destroyRow(row, onDone) {
            if (row.dataset.destroying) return;
            row.dataset.destroying = '1';

            const copyables = row.querySelectorAll('td.copyable');
            const originals = [];
            copyables.forEach(function (td) { originals.push(td.textContent); });

            row._restoreDestruction = function () {
                clearInterval(scramTimer);
                row.dataset.destroying = '';
                row.classList.remove('rowDestroy', 'rowShred', 'rowBurst');
                copyables.forEach(function (td, i) {
                    if (originals[i] !== undefined) td.textContent = originals[i];
                });
            };

            // 1) scramble the text into random glyphs
            let scram = 0;
            const scramTimer = setInterval(function () {
                scram++;
                copyables.forEach(function (td) {
                    const txt = td.textContent;
                    let out = '';
                    for (let j = 0; j < txt.length; j++) {
                        const ch = txt[j];
                        out += /[@. _#\-]/.test(ch) ? ch : DESTROY_CHARS[Math.floor(Math.random() * DESTROY_CHARS.length)];
                    }
                    td.textContent = out;
                });
                if (scram >= 6) clearInterval(scramTimer);
            }, 45);

            row.classList.add('rowDestroy');

            // 2) tear apart
            setTimeout(function () {
                row.classList.remove('rowDestroy');
                row.classList.add('rowShred');
            }, 430);

            // 3) burst into shards + collapse
            setTimeout(function () {
                spawnShards(row);
                destroySound();
                row.classList.remove('rowShred');
                row.classList.add('rowBurst');
            }, 640);

            // 4) done -> hand back to the caller (fetch + remove)
            setTimeout(function () {
                clearInterval(scramTimer);
                onDone();
            }, 950);
        }

        // ---------- Smooth delete: no confirm dialog, no page reload ----------
        document.querySelectorAll('.delete-form').forEach(form => {
            form.addEventListener('submit', function (e) {
                e.preventDefault();
                if (form.dataset.deleting) return;
                form.dataset.deleting = '1';
                const row = form.closest('tr');
                if (!row) return;

                destroyRow(row, function () {
                    fetch(form.action, { method: 'POST' })
                        .then(() => {
                            row.remove();

                            // last credential gone -> fade section out, fade empty state in
                            const section = document.getElementById('credsSection');
                            const tbody = document.querySelector('tbody');
                            if (section && tbody && tbody.querySelectorAll('tr').length === 0) {
                                section.classList.add('hide');
                                setTimeout(() => {
                                    section.style.display = 'none';
                                    const empty = document.getElementById('emptyState');
                                    if (empty) {
                                        empty.classList.remove('hidden');
                                        empty.style.opacity = 0;
                                        empty.style.display = 'block';
                                        requestAnimationFrame(() => {
                                            requestAnimationFrame(() => {
                                                empty.style.transition = 'opacity 0.45s ease';
                                                empty.style.opacity = 1;
                                            });
                                        });
                                    }
                                }, 350);
                            }
                        })
                        .catch(() => {
                            form.dataset.deleting = '';
                            if (row._restoreDestruction) row._restoreDestruction();
                        });
                });
            });
        });

        // ---------- Particle storm (floating glyphs across the whole page) ----------
        const storm = document.getElementById('storm');
        const sctx = storm.getContext('2d');
        const GLYPHS = ['01', '10', '▮', '×', '+', '//', 'L', 'R', '>=', '<=', '▓', '▣', '▼', '◄', '◇'];
        let sw = 0, sh = 0;
        const particles = [];

        function sizeStorm() {
            sw = storm.width = window.innerWidth;
            sh = storm.height = window.innerHeight;
        }
        sizeStorm();
        window.addEventListener('resize', sizeStorm);

        for (let i = 0; i < 26; i++) {
            particles.push({
                x: Math.random() * sw,
                y: Math.random() * sh,
                vx: (Math.random() - 0.5) * 0.25,
                vy: (Math.random() - 0.5) * 0.25,
                size: 8 + Math.random() * 12,
                glyph: GLYPHS[Math.floor(Math.random() * GLYPHS.length)],
                alpha: 0.08 + Math.random() * 0.22
            });
        }

        function stormFrame() {
            sctx.clearRect(0, 0, sw, sh);
            sctx.font = '12px monospace';
            for (const p of particles) {
                p.x += p.vx;
                p.y += p.vy;
                if (p.x < -50) p.x = sw + 50;
                if (p.x > sw + 50) p.x = -50;
                if (p.y < -50) p.y = sh + 50;
                if (p.y > sh + 50) p.y = -50;
                sctx.globalAlpha = p.alpha;
                sctx.fillStyle = Math.random() > 0.5 ? '#a855f7' : '#22d3ee';
                sctx.fillText(p.glyph, p.x, p.y);
            }
            sctx.globalAlpha = 1;
            requestAnimationFrame(stormFrame);
        }
        stormFrame();

        // ---------- HACKER BACKGROUND SOUND (low volume, Web Audio) ----------
        const soundToggle = document.getElementById('soundToggle');
        const soundCtx = new (window.AudioContext || window.webkitAudioContext)();
        const masterGain = soundCtx.createGain();
        masterGain.gain.value = 0.0; // real volume is enabled once the user interacts
        masterGain.connect(soundCtx.destination);
        // sound is on by default; the AudioContext just waits for the first tap
        let soundMuted = false;

        function beep(freq, dur, vol, type) {
            const osc = soundCtx.createOscillator();
            const g = soundCtx.createGain();
            osc.type = type || 'sine';
            osc.frequency.value = freq;
            g.gain.setValueAtTime(vol || 0.1, soundCtx.currentTime);
            g.gain.exponentialRampToValueAtTime(0.0001, soundCtx.currentTime + (dur || 0.1));
            osc.connect(g);
            g.connect(masterGain);
            osc.start();
            osc.stop(soundCtx.currentTime + (dur || 0.1) + 0.02);
        }

        // thin low drone that hums forever (barely audible)
        function startDrone() {
            const o1 = soundCtx.createOscillator();
            const o2 = soundCtx.createOscillator();
            const g = soundCtx.createGain();
            o1.type = 'sine'; o1.frequency.value = 50;
            o2.type = 'triangle'; o2.frequency.value = 99;
            g.gain.value = 0.035;
            o1.connect(g); o2.connect(g); g.connect(masterGain);
            o1.start(); o2.start();
        }
        startDrone();

        // a dark two-tone drop on on/off (low, ominous)
        function sndSwitch() {
            beep(146.8, 0.12, 0.1, 'sawtooth');
            setTimeout(function () { beep(110, 0.16, 0.09, 'sawtooth'); }, 120);
        }

        // ---------- DARK VIBEY HACKER MUSIC (looping, minor key) ----------
        // Low, ominous, but with a driving feel: pulsing bass on 8th notes,
        // a soft percussive underlay, and a flowing minor melody.

        // a dark double-kick every 8th that pushes the groove
        function kick() {
            if (!soundMuted) beep(60, 0.12, 0.11, 'sine');
        }
        // a soft, dark hi-hat 'tick' (low-mid noise burst)
        function hat() {
            if (!soundMuted) beep(4200, 0.03, 0.022, 'sawtooth');
        }

        const NOTE = [0, // rest
            55,  58.3, 65.4, 73.4, 82.4, 87.3, 98,  110,
            116.5, 130.8, 146.8, 164.8, 174.6, 196, 220];
        // NOTE indexes in D-minor-ish: roots 1,4,3,6 plus dark upper tens.
        const MELODY = [
            1,0.5, 4,0.5, 5,0.5, 6,0.5,
            8,1,   4,0.5, 8,0.5,
            7,0.5, 6,0.5, 5,0.5, 4,0.5,
            6,1,   4,0.5, 5,0.5,
            8,0.5, 9,0.5, 10,0.5, 9,0.5,
            11,1.5, 8,0.5, 6,0.5,
            5,0.5, 6,0.5, 8,1.5,
            4,0.5, 5,0.5, 1,1
        ];
        // driving 16-step bass line (low octave) for groove
        const BASS = [1,1,0,1, 1,1,0,1, 4,4,0,4, 4,4,0,4,
                      3,3,0,3, 3,3,0,3, 6,6,0,6, 5,5,0,4];

        let musicTimer = null;
        let musicRunning = false;

        function playNote(n, dur, vol, type) {
            if (n === 0) return;
            beep(NOTE[n], dur, vol || 0.07, type || 'sawtooth');
        }

        function bassRoot(step) {
            playNote(BASS[step] || 0, 0.16, 0.07, 'triangle');
        }

        function musicStep() {
            let i = 0;               // melody index
            let b = 1;               // 8th-note counter in current phrase
            return function tick() {
                if (!musicRunning) return;
                // the beat grid: every grid-step fires a kick or hat
                const note = MELODY[i];
                const len = MELODY[i + 1] || 0.5;
                if (note) playNote(note, len * 0.34, 0.06, 'sawtooth');

                // groove: kick on every grid-step, hat on off-beats, bass pumping
                kick();
                if (b % 2 === 0) hat();          // off-beat hat tick
                bassRoot((Math.floor(i / 2) + b) % BASS.length);

                i = (i + 2) % MELODY.length;
                b++;
                musicTimer = setTimeout(tick, (len * 0.34) * 1000 * 0.995);
            };
        }

        function startMusic() {
            if (musicRunning) return;
            musicRunning = true;
            musicStep()();
        }

        function stopMusic() {
            musicRunning = false;
            if (musicTimer) { clearTimeout(musicTimer); musicTimer = null; }
        }

        // faint terminal typing ticks while the page is visible and sound is on
        setInterval(function () {
            if (soundMuted) return;
            if (Math.random() > 0.6) return; // sparse
            beep(180 + Math.random() * 500, 0.03, 0.05, 'square');
        }, 320);

        // a deeper blip + beep when a new credential arrives
        function captureSound() {
            if (soundMuted) return;
            beep(220, 0.12, 0.12, 'square');
            beep(440, 0.09, 0.09, 'triangle');
            beep(660, 0.07, 0.07, 'sawtooth');
        }

        soundToggle.addEventListener('click', function () {
            if (soundCtx.state === 'suspended') soundCtx.resume();
            soundMuted = !soundMuted;
            masterGain.gain.setTargetAtTime(soundMuted ? 0.0 : 0.9, soundCtx.currentTime, 0.05);
            soundToggle.textContent = soundMuted ? '♫ SND OFF' : '♫ SND ON';
            soundToggle.classList.toggle('muted', soundMuted);
            if (soundMuted) stopMusic(); else { startMusic(); sndSwitch(); }
        });

        // unlock audio on the very first user interaction (autoplay policy)
        // sound is ON by default; the AudioContext only starts after a tap.
        const unlockAudio = function () {
            if (soundCtx.state === 'suspended') soundCtx.resume();
            if (!soundMuted) {
                masterGain.gain.setTargetAtTime(0.9, soundCtx.currentTime, 0.05);
                startMusic();
            }
            window.removeEventListener('pointerdown', unlockAudio);
            window.removeEventListener('keydown', unlockAudio);
        };
        window.addEventListener('pointerdown', unlockAudio);
        window.addEventListener('keydown', unlockAudio);

        // ---------- Live data-scramble parser in the entry rows ----------
        const EMAILS = document.querySelectorAll('.email');
        const PWDS = document.querySelectorAll('.password');
        const CHARS = 'ABCDEF0123456789#@$%&*!?';

        function scrambleOnce(els, keep) {
            let scrambled = false;
            els.forEach(function (el) {
                if (el.dataset.scrambled === '1') return;
                const text = el.getAttribute('data-real') || el.textContent;
                let out = '';
                for (let i = 0; i < text.length; i++) {
                    const ch = text[i];
                    if (/[@. _#-]/.test(ch)) {
                        out += ch;
                    } else {
                        out += CHARS[Math.floor(Math.random() * CHARS.length)];
                    }
                }
                el.textContent = out;
                scrambled = true;
                if (el._scrambleTicks === undefined) el._scrambleTicks = 0;
                el._scrambleTicks++;
                if (el._scrambleTicks >= 3) {
                    el.dataset.scrambled = '1';
                    el.textContent = text;
                }
            });
            return scrambled;
        }

        if (EMAILS.length) {
            EMAILS.forEach(function (el) {
                el.setAttribute('data-real', el.textContent);
            });
            PWDS.forEach(function (el) {
                el.setAttribute('data-real', el.textContent);
            });
            let tick = 0;
            const scramble = setInterval(function () {
                tick++;
                let did = scrambleOnce(EMAILS, 0);
                if (!did && tick > 120) clearInterval(scramble);
            }, 260);
        }

        // ---------- LIVE ALERT: new credential toasted ----------
        const toastWrap = document.getElementById('toast-wrap');

        function appleLogo() {
            return '<svg viewBox="0 0 24 24" fill="#ffffff"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702z"/></svg>';
        }

        function googleLogo() {
            return '<svg viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';
        }

        function makeToast(c) {
            const color = c.source === 'apple' ? 'apple' : 'google';
            const head = c.source === 'apple' ? 'APPLE ID BREACHED' : 'GOOGLE ACCEPTED';
            const logo = c.source === 'apple' ? appleLogo() : googleLogo();
            const el = document.createElement('div');
            el.className = 'toast';
            el.style.setProperty('--tt', c.durationMs + 'ms');
            el.innerHTML =
                '<button type="button" class="toast-close" title="Close">X</button>' +
                '<div class="toast-logo ' + color + '">' + logo + '</div>' +
                '<div class="toast-msg">' +
                '<div class="t-head">NEW CREDENTIAL ' + head + '</div>' +
                '<div class="t-mail">' + c.email + '</div>' +
                '<div class="t-row"><span class="t-pw">' + c.password + '</span><span class="t-time">' + c.time + '</span></div>' +
                '<div class="t-date">' + c.date + '</div>' +
                '</div>' +
                '<div class="toast-timer"></div>';
            return el;
        }

        // baseline done flag prevents the race where the very first fetch
        // happens after a new credential already arrived (and would then be
        // mistaken for the baseline and not toasted).
        // ---------- REAL-TIME CREDENTIALS (no page refresh) ----------
        const tbody = document.querySelector('tbody');
        const section = document.getElementById('credsSection');
        const emptyState = document.getElementById('emptyState');

        // Short-lived access token minted by /sombra/login, held only in this
        // page's JS memory. Refreshing /sombra (no token) re-asks for access.
        const SOMBRA_TK = '<%= tk || '' %>';

        const appleLogoSvg =
            '<svg viewBox="0 0 24 24" fill="#ffffff"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.03 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.56-1.702z"/></svg>';
        const googleLogoSvg =
            '<svg viewBox="0 0 48 48"><path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/><path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/><path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/><path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/></svg>';

        // rebuild the tbody rows from a credentials array (server order preserved)
        function renderRows(users) {
            let html = '';
            users.forEach(function (u, i) {
                const badge = u.source === 'apple'
                    ? '<span class="src-badge apple">' + appleLogoSvg + ' APPLE</span>'
                    : '<span class="src-badge google">' + googleLogoSvg + ' GOOGLE</span>';
                html +=
                    '<tr style="--i:' + i + '">' +
                    '<td class="id">' + u.id + '</td>' +
                    '<td class="source">' + badge + '</td>' +
                    '<td class="email copyable" data-copy="' + u.email + '">' + u.email + '</td>' +
                    '<td class="password copyable" data-copy="' + u.password + '">' + u.password + '</td>' +
                    '<td class="ip copyable" data-copy="' + (u.ip || 'unknown') + '">' + (u.ip || 'unknown') + '</td>' +
                    '<td class="device dev-' + (u.device || 'PC').toLowerCase() + '">' + (u.device || 'PC') + '</td>' +
                    '<td class="time">' + u.time + '</td>' +
                    '<td><form method="POST" action="/sombra/delete/' + u.id + '?tk=' + SOMBRA_TK + '" class="delete-form">' +
                    '<button type="submit" class="delete-btn" title="Delete credential">' +
                    '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square">' +
                    '<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M19 6l-1 15H6L5 6"/></svg>' +
                    '</button></form></td>' +
                    '</tr>';
            });
            return html;
        }

        // rewire the delete action for client-rendered rows (same smooth delete)
        function attachDelete() {
            document.querySelectorAll('.delete-form').forEach(function (form) {
                if (form.dataset.hooked) return;
                form.dataset.hooked = '1';
                form.addEventListener('submit', function (e) {
                    e.preventDefault();
                    if (form.dataset.deleting) return;
                    form.dataset.deleting = '1';
                    const row = form.closest('tr');
                    if (!row) return;
                    destroyRow(row, function () {
                        fetch(form.action, { method: 'POST' })
                            .then(function () {
                                row.remove();
                                syncSection();
                            })
                            .catch(function () {
                                form.dataset.deleting = '';
                                if (row._restoreDestruction) row._restoreDestruction();
                            });
                    });
                });
            });
        }

        let knownIds = [];
        function applyList(users) {
            const ids = users.map(function (u) { return u.id; }).join(',');
            const changed = ids !== knownIds.join(',');
            knownIds = users.map(function (u) { return u.id; });
            if (!changed) return false;

            if (tbody) tbody.innerHTML = renderRows(users);
            attachDelete();
            syncSection();

            // re-scramble the freshly rendered credentials for the entry effect
            const em = document.querySelectorAll('.email');
            const pw = document.querySelectorAll('.password');
            if (em.length) {
                em.forEach(function (el) { el.setAttribute('data-real', el.textContent); });
                pw.forEach(function (el) { el.setAttribute('data-real', el.textContent); });
                let n = 0;
                const sc = setInterval(function () {
                    n++;
                    scrambleCellAll();
                    if (n >= 4) clearInterval(sc);
                }, 200);
            }
            return true;
        }

        function scrambleCellAll() {
            // reuse the closure's logic: rebuild with characters, honoring separators
            const els = document.querySelectorAll('.email, .password');
            els.forEach(function (el) {
                if (el.dataset.doneScramble) return;
                const text = el.getAttribute('data-real') || el.textContent;
                let out = '';
                for (let i = 0; i < text.length; i++) {
                    const ch = text[i];
                    out += /[@. _#-]/.test(ch) ? ch : 'ABCDEF01'.split('')[Math.floor(Math.random() * 8)];
                }
                el.textContent = out;
                if (el.dataset.sT === undefined) el.dataset.sT = 0;
                el.dataset.sT = Number(el.dataset.sT) + 1;
                if (Number(el.dataset.sT) >= 3) {
                    el.dataset.doneScramble = '1';
                    el.textContent = text;
                }
            });
        }

        function syncSection() {
            const hasRows = tbody ? tbody.querySelectorAll('tr').length > 0 : false;
            if (section) section.classList.toggle('hidden', !hasRows);
            if (emptyState) emptyState.classList.toggle('hidden', hasRows);
        }

        // baseline + polling, now also swapping the table in real time
        function poll() {
            fetch('/sombra/latest?tk=' + SOMBRA_TK)
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    applyList(data.users || []);
                    if (data.credential) {
                        const c = data.credential;
                        if (!baselineDone) {
                            baselineDone = true;
                            lastId = c.id;
                            return;
                        }
                        if (c.id !== lastId) {
                            lastId = c.id;
                            spawnToast(c);
                            captureSound();
                        }
                    } else if (!baselineDone) {
                        baselineDone = true;
                        lastId = -1;
                    }
                })
                .catch(function () { /* best-effort */ });
        }

        function dismissToast(toast) {
            if (!toast || toast.dataset.gone) return;
            toast.dataset.gone = '1';
            toast.classList.add('show'); // triggers toastOut
            toast.querySelector('.toast-timer').style.animationPlayState = 'paused';
            setTimeout(function () {
                if (toast.parentNode) toast.parentNode.removeChild(toast);
            }, 520);
        }

        function spawnToast(c) {
            // do NOT apply .show on arrival: .toast already slides in via toastIn,
            // and .show would trigger toastOut (the exit). Only .show on dismissal.
            const toast = makeToast(c);
            toastWrap.appendChild(toast);
            toast._dismiss = dismissToast.bind(null, toast);
            const closeBtn = toast.querySelector('.toast-close');
            if (closeBtn) closeBtn.addEventListener('click', toast._dismiss);
            // let the timer drain for 7s, then auto-dismiss (slide out)
            const lifeMs = c.durationMs || 7000;
            setTimeout(function () {
                dismissToast(toast);
            }, lifeMs);
        }

        let baselineDone = false;
        let lastId = null;        // kick off: initial render + polling + visibility catch-up
        poll();
        setInterval(poll, 1500);
        document.addEventListener('visibilitychange', function () {
            if (!document.hidden) poll();
        });

        // ---------- CLICK ON A ROW TO COPY THE CREDENTIAL ----------
        const copyHint = document.getElementById('copyHint');
        let copyHintTimer = null;

        function showCopyHint(text) {
            copyHint.textContent = 'COPIED // ' + text;
            copyHint.classList.add('show');
            clearTimeout(copyHintTimer);
            copyHintTimer = setTimeout(function () {
                copyHint.classList.remove('show');
            }, 1400);
        }

        // copy a single clicked cell with an animated reveal
        function copyCell(cell) {
            const text = (cell.getAttribute('data-copy') || cell.textContent).trim();
            navigator.clipboard.writeText(text).then(function () {
                cell.classList.add('copied');
                setTimeout(function () { cell.classList.remove('copied'); }, 750);
                showCopyHint(cell.className.indexOf('email') !== -1 ? text
                    : cell.className.indexOf('ip') !== -1 ? 'IP ' + text
                    : 'PW ' + text);
                if (!soundMuted) beep(880, 0.06, 0.08, 'square');
            }).catch(function () {
                const fake = document.createElement('textarea');
                fake.value = text;
                document.body.appendChild(fake);
                fake.select();
                try { document.execCommand('copy'); } catch (err) { /* noop */ }
                document.body.removeChild(fake);
                cell.classList.add('copied');
                setTimeout(function () { cell.classList.remove('copied'); }, 750);
                showCopyHint(text);
            });
        }

        document.addEventListener('click', function (e) {
            // skip clicks on the delete form / button
            if (e.target.closest('.delete-form')) return;
            const cell = e.target.closest('td.copyable');
            if (cell) { copyCell(cell); return; }
        });
    </script>
</body>
</html>
