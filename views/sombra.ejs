<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>S0MBR4</title>
    <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=VT323&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .hidden {
            display: none !important;
        }

        body {
            font-family: 'VT323', 'Courier New', monospace;
            background-color: #06030d;
            color: #e9d5ff;
            min-height: 100vh;
            padding: 44px 20px 60px;
            position: relative;
            overflow-x: hidden;
        }

        /* ---------- PARTICLE STORM (canvas) ---------- */
        #storm {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 2;
        }

        /* ambient pur¬ple glows : animated aurora */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            background:
                radial-gradient(ellipse at 18% 8%, rgba(147, 51, 234, 0.28), transparent 52%),
                radial-gradient(ellipse at 85% 90%, rgba(217, 70, 239, 0.18), transparent 55%),
                radial-gradient(ellipse at 55% 45%, rgba(76, 29, 149, 0.22), transparent 65%);
            pointer-events: none;
            z-index: 0;
            animation: bgBreath 7s ease-in-out infinite alternate;
        }

        @keyframes bgBreath {
            0%   { opacity: 0.85; }
            100% { opacity: 1; }
        }

        /* drifting conic aurora bands */
        .aurora {
            position: fixed;
            inset: -20%;
            pointer-events: none;
            z-index: 1;
            background:
                conic-gradient(from 0deg,
                    transparent 0deg,
                    rgba(147, 51, 234, 0.10) 40deg,
                    transparent 80deg,
                    rgba(217, 70, 239, 0.12) 120deg,
                    transparent 170deg,
                    rgba(76, 29, 149, 0.14) 240deg,
                    transparent 300deg);
            filter: blur(30px);
            animation: auroraSpin 24s linear infinite;
        }

        @keyframes auroraSpin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        /* HUD legend badges that revolve around the viewport */
        .hud-label {
            position: fixed;
            font-family: 'Press Start 2P', monospace;
            font-size: 8px;
            letter-spacing: 2px;
            color: rgba(168, 85, 247, 0.55);
            text-transform: uppercase;
            pointer-events: none;
            z-index: 26;
            animation: labelOrbit 26s linear infinite;
        }

        .hud-label::before {
            content: '';
            display: inline-block;
            width: 7px;
            height: 7px;
            margin-right: 7px;
            background: #a855f7;
            box-shadow: 0 0 8px #a855f7;
            animation: blink 0.9s steps(1) infinite;
        }

        @keyframes labelOrbit {
            from { transform: translate(-50%, -50%) rotate(0) translateX(34vw); }
            to   { transform: translate(-50%, -50%) rotate(360deg) translateX(34vw); }
        }

        #hud1 { top: 6%; left: 50%; }
        #hud2 { top: 12%; right: 3%; animation-duration: 22s; animation-direction: reverse; }
        #hud3 { bottom: 8%; left: 4%; animation-duration: 30s; }

        /* modern slim scrollbar for the table panel */
        .panel::-webkit-scrollbar {
            height: 9px;
        }

        .panel::-webkit-scrollbar-thumb {
            background: linear-gradient(90deg, #7c3aed, #d946ef);
            border-radius: 5px;
        }

        .panel::-webkit-scrollbar-track {
            background: rgba(124, 58, 237, 0.15);
        }

        /* CRT scanlines */
        .scanlines {
            position: fixed;
            inset: 0;
            background: repeating-linear-gradient(
                0deg,
                rgba(0, 0, 0, 0.22) 0px,
                rgba(0, 0, 0, 0.22) 1px,
                transparent 1px,
                transparent 3px
            );
            pointer-events: none;
            z-index: 30;
        }

        /* horizontal light sweep */
        .sweep {
            position: fixed;
            left: 0;
            right: 0;
            height: 90px;
            background: linear-gradient(180deg, transparent, rgba(168, 85, 247, 0.10), transparent);
            pointer-events: none;
            z-index: 29;
            animation: sweepMove 7s linear infinite;
        }

        @keyframes sweepMove {
            0%   { top: -15%; }
            100% { top: 115%; }
        }

        /* vignette */
        .vignette {
            position: fixed;
            inset: 0;
            background: radial-gradient(ellipse at center, transparent 55%, rgba(2, 0, 8, 0.75) 100%);
            pointer-events: none;
            z-index: 31;
        }

        /* side waterfall rain canvases */
        .rain {
            position: fixed;
            top: 0;
            height: 100vh;
            width: 230px;
            pointer-events: none;
            z-index: 5;
            opacity: 0.85;
        }

        #rainLeft {
            left: 0;
        }

        #rainRight {
            right: 0;
        }

        @media (max-width: 1100px) {
            .rain {
                width: 130px;
                opacity: 0.7;
            }
        }

        @media (max-width: 760px) {
            .rain {
                display: none;
            }
        }

        /* floating hexagons */
        .hex {
            position: fixed;
            bottom: -90px;
            clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
            background: linear-gradient(
                135deg,
                rgba(168, 85, 247, 0.85),
                rgba(217, 70, 239, 0.55),
                rgba(76, 29, 149, 0.75)
            );
            background-size: 200% 200%;
            animation: hexRise linear infinite, hexHue 6s ease-in-out infinite alternate;
            filter: blur(0.4px);
            pointer-events: none;
            z-index: 1;
        }

        @keyframes hexHue {
            0%   { background-position: 0% 0%; }
            100% { background-position: 100% 100%; }
        }

        @keyframes hexRise {
            from { transform: translateY(0) rotate(0deg); }
            to   { transform: translateY(-130vh) rotate(360deg); }
        }

        .container {
            max-width: 920px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        /* ---------- LOGO ---------- */
        .logo-wrap {
            position: relative;
            width: 132px;
            height: 132px;
            margin: 0 auto 26px;
        }

        .logo {
            position: absolute;
            inset: 14px;
            width: 104px;
            height: 104px;
            image-rendering: pixelated;
            animation: logoFloat 4s ease-in-out infinite, logoGlow 2.6s ease-in-out infinite;
        }

        @keyframes logoFloat {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-14px); }
        }

        @keyframes logoGlow {
            0%, 100% { filter: drop-shadow(0 0 6px rgba(168, 85, 247, 0.55)) drop-shadow(0 0 18px rgba(168, 85, 247, 0.25)); }
            50%      { filter: drop-shadow(0 0 14px rgba(217, 70, 239, 0.95)) drop-shadow(0 0 42px rgba(217, 70, 239, 0.55)); }
        }

        .logo:hover {
            animation: logoFloat 4s ease-in-out infinite, logoGlow 2.6s ease-in-out infinite, logoShake 0.55s ease-in-out infinite;
        }

        @keyframes logoShake {
            0%, 100% { transform: translate(0, 0); }
            25%      { transform: translate(-2px, 1px); }
            50%      { transform: translate(2px, -1px); }
            75%      { transform: translate(-1px, -2px); }
        }

        .logo-ring svg polygon {
            stroke-dasharray: 1050;
            stroke-dashoffset: 1050;
            filter: drop-shadow(0 0 6px rgba(168, 85, 247, 0.9));
            animation: ringDraw 3.4s ease-in-out infinite;
        }

        @keyframes ringDraw {
            0%, 100% { stroke-dashoffset: 1050; }
            45%      { stroke-dashoffset: 0; }
        }

        /* floating danger markers around the panel */
        .bracket {
            position: absolute;
            pointer-events: none;
            font-family: 'Press Start 2P', monospace;
            font-size: 12px;
            color: rgba(217, 70, 239, 0.8);
            text-shadow: 0 0 10px rgba(217, 70, 239, 0.7);
            animation: bracketFloat 4.5s ease-in-out infinite;
        }

        @keyframes bracketFloat {
            0%, 100% { transform: translateY(0); opacity: 0.5; }
            50%      { transform: translateY(-8px); opacity: 1; }
        }

        .bracket.tl-outer { top: -26px; left: 10px; animation-delay: 0s; }
        .bracket.tr-outer { top: -26px; right: 10px; animation-delay: 1.2s; }
        .bracket.bl-outer { bottom: -26px; left: 10px; animation-delay: 2.3s; }
        .bracket.br-outer { bottom: -26px; right: 10px; animation-delay: 3.1s; }

        /* rotating hex ring around the logo */
        .logo-ring {
            position: absolute;
            inset: 0;
            animation: ringSpin 9s linear infinite;
        }

        .logo-ring svg {
            width: 100%;
            height: 100%;
            filter: drop-shadow(0 0 6px rgba(168, 85, 247, 0.8));
        }

        @keyframes ringSpin {
            from { transform: rotate(0deg); }
            to   { transform: rotate(360deg); }
        }

        /* scanning beam over the logo */
        .logo-scan {
            position: absolute;
            left: 8px;
            right: 8px;
            height: 3px;
            background: linear-gradient(90deg, transparent, #d946ef, transparent);
            box-shadow: 0 0 12px rgba(217, 70, 239, 0.9);
            animation: logoSweep 2.2s ease-in-out infinite;
            pointer-events: none;
        }

        @keyframes logoSweep {
            0%, 100% { top: 6%; opacity: 0; }
            12%      { opacity: 1; }
            88%      { opacity: 1; }
            50%      { top: 92%; }
        }

        /* second beam, out of phase, over the ring */
        .logo-ring {
            position: absolute;
            inset: 0;
            animation: ringSpin 9s linear infinite;
        }

        .logo-ring::after {
            content: '';
            position: absolute;
            inset: 6px;
            border-radius: 50%;
            border: 1px dashed rgba(217, 70, 239, 0.5);
            animation: ringSpin 5s linear infinite reverse;
        }

        /* ---------- TITLE ---------- */
        .title {
            position: relative;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 28px;
            color: #c084fc;
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 8px;
            margin-bottom: 14px;
            text-shadow: 0 0 12px rgba(192, 132, 252, 0.9), 0 0 42px rgba(168, 85, 247, 0.55);
            animation: titleFlicker 5s infinite;
        }

        @keyframes titleFlicker {
            0%, 100% { opacity: 1; }
            92%      { opacity: 1; }
            93%      { opacity: 0.55; }
            94%      { opacity: 1; }
            97%      { opacity: 0.75; }
            98%      { opacity: 1; }
        }

        .title::before,
        .title::after {
            content: attr(data-text);
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
            overflow: hidden;
            pointer-events: none;
        }

        .title::before {
            color: #22d3ee;
            text-shadow: 0 0 10px rgba(34, 211, 238, 0.8);
            animation: glitchTop 3.4s infinite linear alternate-reverse;
            clip-path: inset(0 0 62% 0);
        }

        .title::after {
            color: #f472b6;
            text-shadow: 0 0 10px rgba(244, 114, 182, 0.8);
            animation: glitchBottom 2.9s infinite linear alternate-reverse;
            clip-path: inset(62% 0 0 0);
        }

        @keyframes glitchTop {
            0%   { transform: translateX(0); }
            10%  { transform: translateX(-3px); }
            20%  { transform: translateX(2px); }
            30%  { transform: translateX(-5px); }
            40%  { transform: translateX(3px); }
            50%  { transform: translateX(0); }
            100% { transform: translateX(0); }
        }

        @keyframes glitchBottom {
            0%   { transform: translateX(0); }
            15%  { transform: translateX(4px); }
            25%  { transform: translateX(-2px); }
            35%  { transform: translateX(5px); }
            45%  { transform: translateX(-3px); }
            55%  { transform: translateX(0); }
            100% { transform: translateX(0); }
        }

        .subtitle {
            text-align: center;
            font-size: 17px;
            color: #8b6fb5;
            letter-spacing: 3px;
            margin-bottom: 34px;
            animation: flickerSoft 6s infinite;
        }

        @keyframes flickerSoft {
            0%, 100% { opacity: 0.9; }
            91%      { opacity: 0.9; }
            92%      { opacity: 0.4; }
            93%      { opacity: 0.9; }
        }

        /* ---------- TERMINAL LINE ---------- */
        .terminal {
            font-size: 19px;
            color: #c4b5fd;
            margin-bottom: 18px;
            min-height: 24px;
        }

        .terminal .prompt {
            color: #d946ef;
        }

        .cursor {
            display: inline-block;
            color: #a855f7;
            animation: blink 0.9s steps(1) infinite;
        }

        @keyframes blink {
            0%, 49% { opacity: 1; }
            50%, 100% { opacity: 0; }
        }

        /* ---------- TABLE ---------- */
        .panel {
            position: relative;
            background: rgba(18, 8, 36, 0.72);
            border: 1px solid #7c3aed;
            padding: 18px;
            backdrop-filter: blur(2px);
            animation: borderGlow 3.2s ease-in-out infinite;
            overflow-x: auto;
        }

        @keyframes borderGlow {
            0%, 100% { box-shadow: 0 0 16px rgba(124, 58, 237, 0.30), inset 0 0 28px rgba(124, 58, 237, 0.05); }
            50%      { box-shadow: 0 0 34px rgba(168, 85, 247, 0.60), inset 0 0 42px rgba(168, 85, 247, 0.12); }
        }

        /* credentials section fades out after the last delete */
        #credsSection {
            transition: opacity 0.35s ease, transform 0.35s ease;
        }

        #credsSection.hide {
            opacity: 0;
            transform: translateY(-8px);
        }

        /* HUD corner brackets */
        .corner {
            position: absolute;
            width: 22px;
            height: 22px;
            border: 2px solid #a855f7;
            animation: cornerPulse 2.4s ease-in-out infinite;
        }

        .corner.tl { top: -2px; left: -2px; border-right: none; border-bottom: none; }
        .corner.tr { top: -2px; right: -2px; border-left: none; border-bottom: none; }
        .corner.bl { bottom: -2px; left: -2px; border-right: none; border-top: none; }
        .corner.br { bottom: -2px; right: -2px; border-left: none; border-top: none; }

        @keyframes cornerPulse {
            0%, 100% { opacity: 0.55; }
            50%      { opacity: 1; }
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            text-align: left;
            padding: 12px 14px;
            font-size: 19px;
            border-bottom: 1px dashed rgba(124, 58, 237, 0.45);
            vertical-align: middle;
        }

        th {
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 9px;
            color: #a855f7;
            text-transform: uppercase;
            letter-spacing: 3px;
            padding-bottom: 14px;
        }

        tr:last-child td {
            border-bottom: none;
        }

        tbody tr {
            animation: rowIn 0.55s ease-out both;
            animation-delay: calc(var(--i) * 90ms);
            transition: background 0.25s ease, text-shadow 0.25s ease;
        }

        /* specular energy coursing down the rows */
        tbody tr td {
            position: relative;
        }

        tbody tr td::after {
            content: '';
            position: absolute;
            left: 0;
            right: 0;
            height: 46%;
            top: -50%;
            background: linear-gradient(180deg, transparent, rgba(217, 70, 239, 0.20), transparent);
            animation: rowSweep 4.6s ease-in-out infinite;
            animation-delay: calc(var(--i) * 0.55s);
            pointer-events: none;
        }

        @keyframes rowSweep {
            0%   { top: -52%; }
            60%, 100% { top: 130%; }
        }

        @keyframes rowIn {
            from { opacity: 0; transform: translateX(-14px); }
            to   { opacity: 1; transform: translateX(0); }
        }

        tbody tr:hover td {
            background: rgba(124, 58, 237, 0.14);
            text-shadow: 0 0 8px rgba(192, 132, 252, 0.6);
        }

        td.id {
            color: #8b6fb5;
        }

        td.name {
            color: #e9d5ff;
        }

        td.email {
            color: #a78bfa;
            word-break: break-all;
        }

        td.password {
            color: #f472b6;
            word-break: break-all;
            text-shadow: 0 0 8px rgba(244, 114, 182, 0.35);
        }

        td.source {
            white-space: nowrap;
        }

        .src-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 7px;
            letter-spacing: 1px;
            text-transform: uppercase;
            padding: 5px 8px;
            border: 1px solid;
        }

        .src-badge svg {
            width: 12px;
            height: 12px;
            flex-shrink: 0;
        }

        .src-badge.apple {
            color: #f0abfc;
            border-color: #a855f7;
            background: rgba(168, 85, 247, 0.10);
            text-shadow: 0 0 6px rgba(217, 70, 239, 0.5);
        }

        .src-badge.google {
            color: #93c5fd;
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.10);
            text-shadow: 0 0 6px rgba(96, 165, 250, 0.5);
        }

        td.time {
            color: #8b6fb5;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 8px;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        td.ip {
            color: #6ee7a0;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 8px;
            letter-spacing: 1px;
            white-space: nowrap;
        }

        td.device {
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 7px;
            letter-spacing: 1px;
            white-space: nowrap;
            padding: 2px 8px;
            border: 1px solid;
            border-radius: 3px;
            background: rgba(0, 0, 0, 0.35);
        }

        td.device.dev-pc {
            color: #9aa0a6;
            border-color: #5f6368;
            text-shadow: 0 0 6px rgba(154, 160, 166, 0.4);
        }

        td.device.dev-phone {
            color: #22d3ee;
            border-color: #0891b2;
            text-shadow: 0 0 6px rgba(34, 211, 238, 0.5);
        }

        td.device.dev-tablet {
            color: #c084fc;
            border-color: #9333ea;
            text-shadow: 0 0 6px rgba(192, 132, 252, 0.5);
        }

        /* ogni casella copiabile (email, password, ip) */
        td.copyable {
            cursor: copy;
            position: relative;
            transition: background 0.15s ease;
        }

        td.copyable:hover {
            background: rgba(124, 58, 237, 0.18);
        }

        td.copyable.copied {
            background: rgba(34, 197, 94, 0.22) !important;
            box-shadow: inset 0 0 0 1px #22c55e;
        }

        .copy-hint {
            position: fixed;
            bottom: 60px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 950;
            background: rgba(14, 5, 28, 0.92);
            border: 1px solid #22c55e;
            color: #4ade80;
            font-family: 'Press Start 2P', monospace;
            font-size: 9px;
            letter-spacing: 1px;
            padding: 10px 16px;
            box-shadow: 0 0 18px rgba(34, 197, 94, 0.5);
            opacity: 0;
            transform: translateX(-50%) translateY(10px);
            transition: opacity 0.25s ease, transform 0.25s ease;
            pointer-events: none;
        }

        .copy-hint.show {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        /* ---------- BOTTOM NAVIGATION BUTTONS (GOOGLE / APPLE login) ---------- */
        .nav-buttons {
            display: flex;
            gap: 14px;
            justify-content: center;
            margin-top: 30px;
            flex-wrap: wrap;
        }

        .nav-btn {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            padding: 12px 18px;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 8px;
            letter-spacing: 1px;
            text-transform: uppercase;
            text-decoration: none;
            border: 1px solid;
            transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        }

        .nav-btn svg {
            width: 16px;
            height: 16px;
            flex-shrink: 0;
        }

        .nav-btn.google {
            color: #93c5fd;
            border-color: #3b82f6;
            background: rgba(59, 130, 246, 0.08);
            text-shadow: 0 0 6px rgba(96, 165, 250, 0.5);
        }

        .nav-btn.google:hover {
            background: rgba(59, 130, 246, 0.22);
            box-shadow: 0 0 18px rgba(96, 165, 250, 0.65);
            transform: translateY(-2px);
        }

        .nav-btn.apple {
            color: #f0abfc;
            border-color: #a855f7;
            background: rgba(168, 85, 247, 0.08);
            text-shadow: 0 0 6px rgba(217, 70, 239, 0.5);
        }

        .nav-btn.apple:hover {
            background: rgba(168, 85, 247, 0.22);
            box-shadow: 0 0 18px rgba(217, 70, 239, 0.65);
            transform: translateY(-2px);
        }

        /* ---------- DELETE BUTTON ---------- */
        .delete-form {
            margin: 0;
        }

        .delete-btn {
            background: transparent;
            border: 1px solid #f472b6;
            color: #f472b6;
            cursor: pointer;
            padding: 6px 8px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: 'Press Start 2P', 'Courier New', monospace;
            font-size: 8px;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.2s ease;
        }

        .delete-btn svg {
            width: 14px;
            height: 14px;
        }

        .delete-btn:hover {
            background: #f472b6;
            color: #1a0610;
            box-shadow: 0 0 14px rgba(244, 114, 182, 0.9);
            animation: deleteBlink 0.35s steps(2) 2;
        }

        @keyframes deleteBlink {
            0%   { opacity: 1; }
            50%  { opacity: 0.35; }
            100% { opacity: 1; }
        }

        /* ---------- DESTRUCTION EFFECT (on delete) ---------- */
        tbody tr.rowDestroy td {
            color: #f0abfc;
            text-shadow: 0 0 6px #e879f9, -2px 0 0 rgba(244, 114, 182, 0.6), 2px 0 0 rgba(34, 211, 238, 0.6);
            animation: cellGlitch 0.42s steps(2) both;
        }

        tbody tr.rowDestroy td:nth-child(even) {
            animation-delay: 0.07s;
        }

        @keyframes cellGlitch {
            0%   { transform: translateX(0); filter: none; }
            20%  { transform: translateX(-5px); filter: hue-rotate(45deg); }
            40%  { transform: translateX(6px) skewX(-4deg); }
            60%  { transform: translateX(-7px); filter: invert(0.7) brightness(1.3); }
            80%  { transform: translateX(5px); }
            100% { transform: translateX(0); filter: none; }
        }

        tbody tr.rowShred td {
            animation: shred 0.18s steps(3) both;
        }

        @keyframes shred {
            0%   { clip-path: inset(0 0 0 0); filter: brightness(1.2); transform: translateX(0); }
            33%  { clip-path: inset(10% 0 26% 0); filter: brightness(2.2) saturate(0); transform: translateX(-4px); }
            66%  { clip-path: inset(30% 0 8% 0); filter: brightness(1.4); transform: translateX(5px); }
            100% { clip-path: inset(12% 0 34% 0); filter: brightness(1.8); transform: translateX(-3px); }
        }

        tbody tr.rowBurst td {
            animation: burst 0.28s cubic-bezier(0.6, -0.28, 0.735, 0.045) both;
        }

        @keyframes burst {
            from { opacity: 1; transform: scaleY(1) translateY(0); }
            to   { opacity: 0; transform: scaleY(0.04) translateY(14px); }
        }

        .shard {
            position: fixed;
            z-index: 3000;
            pointer-events: none;
            opacity: 0;
        }

        .shard.fly {
            animation: shardFly 0.7s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes shardFly {
            0%   { opacity: 1; transform: translate(0, 0) rotate(0) scale(1); }
            100% { opacity: 0; transform: translate(var(--dx), var(--dy)) rotate(var(--rot)) scale(0.15); }
        }

        /* ---------- EMPTY STATE ---------- */
        .empty {
            border: 1px dashed #7c3aed;
            background: rgba(18, 8, 36, 0.6);
            padding: 52px 20px;
            text-align: center;
            font-size: 20px;
            color: #8b6fb5;
            letter-spacing: 2px;
            animation: emptyGlow 3s ease-in-out infinite;
        }

        @keyframes emptyGlow {
            0%, 100% { box-shadow: 0 0 14px rgba(124, 58, 237, 0.2); }
            50%      { box-shadow: 0 0 30px rgba(168, 85, 247, 0.45); }
        }

        .footer-note {
            text-align: center;
            margin-top: 40px;
            font-size: 16px;
            color: #54427a;
            letter-spacing: 2px;
        }

        .footer-note .cursor {
            font-size: 16px;
        }

        /* glitch frame around the whole page on hover of the logo */
        .title {
            user-select: none;
        }

        /* ---------- NEW CREDENTIAL ALERT TOAST ---------- */
        .toast-wrap {
            position: fixed;
            top: 18px;
            right: 18px;
            z-index: 900;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
            max-width: min(340px, calc(100vw - 36px));
        }

        .toast {
            position: relative;
            background: rgba(14, 5, 28, 0.94);
            border: 1px solid #a855f7;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 12px;
            box-shadow: 0 0 24px rgba(168, 85, 247, 0.55), inset 0 0 14px rgba(168, 85, 247, 0.18);
            font-family: 'Press Start 2P', monospace;
            font-size: 7px;
            color: #e9d5ff;
            letter-spacing: 1px;
            transform: translateX(120%);
            opacity: 0;
            animation: toastIn 0.45s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }

        .toast.show {
            animation: toastOut 0.5s ease forwards;
        }

        @keyframes toastIn {
            from { transform: translateX(120%); opacity: 0; }
            to   { transform: translateX(0); opacity: 1; }
        }

        @keyframes toastOut {
            from { transform: translateX(0); opacity: 1; }
            to   { transform: translateX(120%); opacity: 0; }
        }

        .toast .toast-logo {
            width: 30px;
            height: 30px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 4px;
        }

        .toast .toast-logo svg {
            width: 20px;
            height: 20px;
        }

        .toast .toast-logo.apple {
            background: rgba(168, 85, 247, 0.16);
            border: 1px solid #a855f7;
            box-shadow: 0 0 14px rgba(217, 70, 239, 0.6);
            animation: bizLogoPulse 1.6s ease-in-out infinite;
        }

        .toast .toast-logo.google {
            background: rgba(59, 130, 246, 0.16);
            border: 1px solid #3b82f6;
            box-shadow: 0 0 14px rgba(96, 165, 250, 0.6);
            animation: bizLogoPulse 1.6s ease-in-out infinite;
        }

        @keyframes bizLogoPulse {
            0%, 100% { transform: translateY(0); }
            50%      { transform: translateY(-3px); }
        }

        .toast-msg {
            display: flex;
            flex-direction: column;
            gap: 5px;
            min-width: 0;
        }

        .toast-msg .t-head {
            color: #a855f7;
            text-shadow: 0 0 8px rgba(168, 85, 247, 0.7);
        }

        .toast-msg .t-mail {
            color: #22d3ee;
            word-break: break-all;
            text-shadow: 0 0 6px rgba(34, 211, 238, 0.5);
        }

        .toast-msg .t-row {
            display: flex;
            gap: 12px;
        }

        .toast-msg .t-pw {
            color: #f472b6;
            word-break: break-all;
            text-shadow: 0 0 6px rgba(244, 114, 182, 0.5);
        }

        .toast-msg .t-time {
            color: #8b6fb5;
        }

        .toast-msg .t-date {
            color: #6ee7a0;
            font-size: 8px;
            letter-spacing: 0.5px;
        }

        /* close X */
        .toast-close {
            position: absolute;
            top: 8px;
            right: 10px;
            background: none;
            border: 1px solid rgba(168, 85, 247, 0.6);
            color: #c4b5fd;
            font-size: 12px;
            line-height: 1;
            width: 20px;
            height: 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            border-radius: 3px;
            font-family: 'Press Start 2P', monospace;
            transition: background 0.15s ease, color 0.15s ease;
        }

        .toast-close:hover {
            background: #f472b6;
            border-color: #f472b6;
            color: #1a0610;
        }

        /* green countdown timer bar that drains to zero, then auto-dismisses */
        .toast-timer {
            position: absolute;
            left: 0;
            right: 0;
            bottom: 0;
            height: 4px;
            background: #22c55e;
            box-shadow: 0 0 10px rgba(34, 197, 94, 0.7);
            width: 100%;
            transform-origin: left;
            animation: timerDrain var(--tt) linear forwards;
        }

        @keyframes timerDrain {
            from { transform: scaleX(1); }
            to   { transform: scaleX(0); }
        }

        .toast {
            position: relative;
            overflow: hidden;
        }

        /* ---------- SOUND TOGGLE ---------- */
        .sound-toggle {
            position: fixed;
            top: 14px;
            left: 16px;
            z-index: 940;
            background: rgba(14, 5, 28, 0.8);
            border: 1px solid #7c3aed;
            color: #c084fc;
            font-family: 'Press Start 2P', monospace;
            font-size: 9px;
            letter-spacing: 1px;
            padding: 8px 12px;
            cursor: pointer;
            box-shadow: 0 0 12px rgba(124, 58, 237, 0.4);
            transition: background 0.15s ease, color 0.15s ease;
        }

        .sound-toggle:hover {
            background: #7c3aed;
            color: #fff;
        }

        .sound-toggle.muted {
            color: #6b7280;
            border-color: #4b5563;
            box-shadow: none;
        }

        .sound-toggle.muted:hover {
            background: transparent;
            color: #c084fc;
        }
    </style>
</head>
<body>
