# Copiato da setup.sh in /etc/starbucks-portal.env (letto dai servizi systemd).
#
# Due mestieri sullo stesso Pi, comandati da `starbucks-mode`:
#   campo -> il Pi si aggancia all'hotspot e crea la rete col portale
#   casa  -> il Pi e' un normale Pi-hole (cavo ethernet)
PORT=8080
PORTAL_ENABLED=1
PORTAL_GRANT=1
PORTAL_HOSTS=10.3.0.1
PORTAL_REDIRECT_BASE=http://10.3.0.1

# Rete del portale
PORTAL_IP=10.3.0.1
PORTAL_IP_CIDR=10.3.0.1/24
PORTAL_AP_IFACE=ap0
PORTAL_SSID="Starbucks_Free_WiFi"
PORTAL_WEB_PORT=8080

# Uplink (l'hotspot a cui il Pi si aggancia)
PORTAL_UPLINK=wlan0
PORTAL_UPLINK_CON=portal-uplink
# il nome della "Rete 1" mostrato nella schermata finale (spazi tra virgolette)
PORTAL_UPSTREAM_SSID="Rete 1"

# Firewall: catena di gating + catena di dirottamento DNS
PORTAL_CHAIN=PORTAL_CLIENTS
PORTAL_DNS_CHAIN=PORTAL_DNS

# Dove sta l'app
PORTAL_APP_DIR=/opt/starbucks-portal
